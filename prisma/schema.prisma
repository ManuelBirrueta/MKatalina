// ============================================================================
//  MKatalina · Esquema de base de datos (Prisma) · Fase 13 · Etapa 1
// ============================================================================
//
//  QUÉ ES ESTE ARCHIVO
//  -------------------
//  Este es el "plano" de nuestra base de datos. Prisma lee este archivo y a
//  partir de él (1) genera el cliente tipado de TypeScript que usaremos para
//  consultar la BD y (2) genera las migraciones SQL que crean/modifican las
//  tablas reales en Postgres.
//
//  DECISIÓN DE ARQUITECTURA CLAVE
//  ------------------------------
//  Los PRODUCTOS VIVEN EN LA BASE DE DATOS (modelos Product y ProductImage, al
//  final de este archivo) para que un administrador pueda crearlos y editarlos
//  desde el panel, con sus imágenes. (Antes estaban en src/data/products.ts;
//  se migraron con un script de seed.)
//
//  Aun así, los demás modelos (pedidos, apartados, reseñas, wishlist, carrito)
//  SIGUEN apuntando al producto con un `productSlug` de texto, SIN llave
//  foránea. Es a propósito: un pedido o apartado es una factura histórica y
//  debe sobrevivir aunque el producto se oculte o cambie. Por eso, a un
//  producto que ya tuvo ventas se le OCULTA (isActive = false), no se borra.
//
//  PRINCIPIO DE "SNAPSHOT INMUTABLE"
//  ---------------------------------
//  Cuando alguien compra o aparta, guardamos una COPIA CONGELADA del nombre y
//  precio de ese momento (campos `*Snapshot`). Si mañana cambias el nombre o
//  el precio del producto en el código, las facturas viejas NO cambian. Esto
//  es un requisito de negocio (facturación) que tú definiste.
//
//  CONEXIÓN A SUPABASE (dos URLs, a propósito)
//  -------------------------------------------
//  Supabase nos da un Postgres. Prisma necesita DOS cadenas de conexión:
//    · url       -> conexión "pooled" (puerto 6543). La usan las consultas
//                   normales en producción serverless (muchas conexiones
//                   cortas). Requiere ?pgbouncer=true al final.
//    · directUrl -> conexión "directa" (puerto 5432). Prisma la usa SOLO para
//                   correr migraciones. Si falta, las migraciones fallan.
//  Ambas viven en .env.local (nunca se suben a Git).
//
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (6543) para consultas
  directUrl = env("DIRECT_URL")   // directa (5432) para migraciones
}

// ============================================================================
//  ENUMS  (valores en español, como acordamos)
// ----------------------------------------------------------------------------
//  Nota: los NOMBRES de los tipos van en inglés (OrderStatus...) para coincidir
//  con los nombres de los modelos que definiste en tu documento; los VALORES
//  van en español porque a menudo se muestran en el panel de administración.
//  Los identificadores de enum no permiten acentos, por eso "ESTANDAR".
// ============================================================================

/// Estado del ciclo de vida de un pedido normal.
enum OrderStatus {
  PENDIENTE // creado pero el pago aún no se confirma
  PAGADO // PayPal confirmó el pago
  PROCESANDO // se está preparando el envío
  ENVIADO // ya salió a reparto / paquetería
  ENTREGADO // el cliente lo recibió
  CANCELADO // anulado
}

/// Estado del ciclo de vida de un apartado (layaway).
enum ReservationStatus {
  ACTIVO // anticipo pagado, dentro de los 5 días
  COMPLETADO // se liquidó el monto restante
  EXPIRADO // pasaron los 5 días sin liquidar
  CANCELADO // anulado manualmente
}


// ============================================================================
//  MODELO: Profile
// ----------------------------------------------------------------------------
//  Perfil de la aplicación. Tiene relación 1-a-1 con el usuario de
//  Supabase Auth: COMPARTEN EL MISMO id (un UUID).
//
//  ¿Por qué separar Profile de "el usuario"? Porque Supabase guarda la parte
//  sensible de la cuenta (contraseña, sesión, email verificado) en su propio
//  esquema `auth`, que NO tocamos con Prisma. Aquí guardamos solo los datos
//  de negocio del usuario. En la Etapa 2, al registrarse alguien, crearemos
//  automáticamente su fila Profile con el mismo id que le asignó Supabase.
//
//  Por eso NO ponemos una llave foránea a auth.users: viven en esquemas
//  distintos y lo mantenemos simple. La consistencia la garantiza el código
//  de registro.
// ============================================================================
model Profile {
  id    String  @id @db.Uuid // == id del usuario en Supabase Auth
  email String  @unique
  firstName String?
  lastName  String?
  phone     String?
  locale    String  @default("es") // idioma preferido: "es" | "en"
  role String @default("customer") // "customer" | "admin"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones inversas (un perfil tiene muchos de cada uno de estos).
  addresses     Address[]
  orders        Order[]
  reservations  Reservation[]
  reviews       Review[]
  wishlistItems WishlistItem[]
  cartItems     CartItem[]

  @@map("profiles")
}

// ============================================================================
//  MODELO: Address
// ----------------------------------------------------------------------------
//  Direcciones GUARDADAS de un usuario con cuenta (su "libreta de
//  direcciones"). OJO: la dirección concreta de un pedido NO se lee de aquí;
//  se COPIA (snapshot) dentro del propio Order al momento de comprar. Así, si
//  el usuario luego edita o borra esta dirección, los pedidos viejos no se
//  alteran. Esta tabla existe solo para autocompletar el checkout.
//  Los invitados no usan esta tabla (escriben su dirección directo en el pedido).
// ============================================================================
model Address {
  id        String  @id @default(uuid())
  profileId String  @db.Uuid
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  recipientName String // a nombre de quién llega
  phone         String
  street        String // calle
  extNumber     String // número exterior
  intNumber     String? // número interior (opcional)
  colonia       String // colonia / barrio (término MX)
  city          String
  state         String
  postalCode    String
  country       String  @default("MX")
  isDefault     Boolean @default(false) // dirección predeterminada del usuario

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
  @@map("addresses")
}

// ============================================================================
//  MODELO: Order  (Pedido)
// ----------------------------------------------------------------------------
//  Un pedido de compra directa. El `id` NO es un UUID: es tu identificador de
//  negocio con prefijo "MKTL-" (ej. "MKTL-000042"), que se genera EN EL
//  SERVIDOR (Etapa 4). Por eso este campo no tiene @default: siempre lo
//  fijamos nosotros al crear el pedido.
//
//  CHECKOUT COMO INVITADO: `profileId` es OPCIONAL (String?). Un pedido puede
//  existir sin cuenta. Por eso guardamos también email/teléfono de contacto
//  directamente en el pedido: es la única forma de contactar a un invitado.
//
//  DIRECCIÓN Y MONTOS "CONGELADOS": los campos de envío y los importes se
//  copian aquí al comprar (snapshot). La factura queda fija para siempre.
// ============================================================================
model Order {
  id String @id // "MKTL-XXXXXX", generado en el cliente (por ahora)

  profileId String?  @db.Uuid // null = compra como invitado
  profile   Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  // Contacto
  email String
  phone String

  // Snapshot de datos personales + dirección (los campos del formulario)
  firstName    String
  lastName     String
  address      String  // calle y número
  addressLine2 String? // interior / depto (opcional)
  neighborhood String  // colonia
  city         String
  state        String
  postalCode   String
  country      String  @default("MX")
  notes        String? // notas para el repartidor

  // Envío (snapshot)
  shippingMethodId String // "estandar" | "express"
  shippingLabel    String // etiqueta ya resuelta al idioma de compra
  shippingCost     Int    // pesos enteros

  // Montos (pesos enteros)
  subtotal Int
  total    Int
  currency String @default("MXN")

  // Estado y metadatos
  status        OrderStatus @default(PAGADO) // pago simulado por ahora
  locale        String      @default("es")
  paypalOrderId String? // para el pago real (paso 2)

  // ── Envío (Fase 13 · Etapa 6B) ─────────────────────────────────────────
  // Se llenan cuando el admin marca el pedido como ENVIADO / ENTREGADO.
  // carrier: "estafeta" | "dhl" | "local" (ver src/lib/shipping-carriers.ts).
  carrier        String?
  // Número de guía de la paquetería (null en entrega local).
  trackingNumber String?
  shippedAt      DateTime?
  deliveredAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]

  @@index([profileId])
  @@index([status])
  @@map("orders")
}

// ============================================================================
//  MODELO: OrderItem  (Renglón de pedido)
// ----------------------------------------------------------------------------
//  Cada producto dentro de un pedido. Como los productos viven en código,
//  guardamos su `productSlug` para saber cuál era, MÁS un `nameSnapshot`: el
//  nombre YA RESUELTO al idioma del pedido en ese momento. Si el catálogo
//  cambia después, este renglón conserva el nombre y precio originales.
// ============================================================================
model OrderItem {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productSlug      String
  nameSnapshot     String  // nombre congelado, ya traducido al idioma del pedido
  unitPrice        Int     // precio unitario congelado (pesos enteros)
  quantity         Int
  lineTotal        Int     // unitPrice * quantity (congelado)
  imageSnapshot    String? // imagen al momento (para la confirmación)
  categorySnapshot String? // categoría al momento

  @@index([orderId])
  @@map("order_items")
}

// ============================================================================
//  MODELO: Reservation  (Apartado / Layaway)
// ----------------------------------------------------------------------------
//  Un apartado: el cliente paga un ANTICIPO del 20% y tiene 5 DÍAS para
//  liquidar el resto. Estas reglas de negocio quedan "grabadas" en los campos.
//
//  El `id` usa prefijo propio "APTD-" (ej. "APTD-000007"), generado en el
//  servidor, para distinguirlo a simple vista de un pedido normal.
//
//  `profileId` se deja OPCIONAL a nivel de esquema por flexibilidad, pero en
//  la práctica exigiremos sesión iniciada para apartar (un compromiso de 5
//  días es difícil de rastrear para un invitado). Esa regla se aplicará en el
//  código de la Etapa 4, no aquí.
// ============================================================================
model Reservation {
  id String @id // "APTD-XXXXXX", generado en el servidor al cobrar el anticipo

  profileId String  @db.Uuid
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  // Snapshot inmutable del producto (nombre ya resuelto al idioma, precio,
  // imagen, categoría, etc.). Es un "documento", por eso va como JSON.
  productSnapshot Json

  // Montos en pesos enteros. depositAmount = 20% del precio; remaining = resto.
  depositAmount   Int
  remainingAmount Int

  // Estado persistido: ACTIVO / COMPLETADO / CANCELADO.
  // "expirado" NO se guarda: se calcula al leer comparando expiresAt.
  status ReservationStatus @default(ACTIVO)

  // "pickup" | "shipping" | null. Se llena al completar.
  deliveryMethod String?

  expiresAt   DateTime
  completedAt DateTime?

  // Orden de PayPal con la que se cobró el ANTICIPO (20%).
  paypalOrderId String?

  // Idioma en que se hizo el apartado ("es" | "en"), para que los correos
  // lleguen en ese idioma (Etapa 6B). Los apartados viejos quedan en "es".
  locale String @default("es")

  // ── Liquidación del 80% restante (Fase 13 · Etapa 5) ──────────────────
  // Se llenan cuando el cliente completa el apartado pagando con PayPal.
  // Si el admin lo marca COMPLETADO a mano (pago en persona), quedan vacíos:
  // así el panel distingue "pagado en línea" de "pagado en tienda".

  // Orden de PayPal con la que se cobró el resto (+ envío, si aplica).
  completionPaypalOrderId String?
  // Método de envío del checkout ("estandar" | "express"); null = recoger.
  shippingMethodId        String?
  // Costo del envío cobrado, en pesos enteros (0 = recoger en tienda).
  shippingCost            Int     @default(0)
  // Dirección de envío CONGELADA al completar (nombre, teléfono, calle,
  // colonia, ciudad, estado, CP, notas). JSON por ser un "documento" que no
  // cambia aunque el cliente edite después sus datos. null = recoger.
  shippingAddress         Json?

  // ── Envío de la pieza (Etapa 6B) ───────────────────────────────────────
  // Solo en apartados liquidados con envío, cuando el admin los marca como
  // enviados. Mismos valores que en Order.
  carrier        String?
  trackingNumber String?
  shippedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
  @@index([status])
  @@index([expiresAt])
  @@map("reservations")
}
// ============================================================================
//  MODELO: Review  (Reseña)
// ----------------------------------------------------------------------------
//  Reseña de un producto. Requiere cuenta (profileId obligatorio). Las reseñas
//  NO se traducen (las escribe el cliente en su idioma). La restricción
//  @@unique evita que una misma persona reseñe el mismo producto dos veces.
// ============================================================================
model Review {
  id        String  @id @default(uuid())
  profileId String  @db.Uuid
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  productSlug String // producto reseñado (referencia al catálogo en código)
  rating      Int // calificación 1..5 (validamos el rango en el servidor)
  title       String?
  body        String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, productSlug]) // una reseña por persona y producto
  @@index([productSlug]) // para listar reseñas de un producto rápido
  @@map("reviews")
}

// ============================================================================
//  MODELO: WishlistItem  (Lista de deseos)
// ----------------------------------------------------------------------------
//  Un producto marcado como favorito por un usuario. Es una simple relación
//  (usuario <-> productSlug). El @@unique impide duplicados.
// ============================================================================
model WishlistItem {
  id        String  @id @default(uuid())
  profileId String  @db.Uuid
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  productSlug String
  createdAt   DateTime @default(now())

  @@unique([profileId, productSlug])
  @@index([profileId])
  @@map("wishlist_items")
}

// ============================================================================
//  MODELO: CartItem  (Carrito persistente)
// ----------------------------------------------------------------------------
//  El carrito de un usuario CON SESIÓN, guardado en la BD para que lo
//  "siga" entre dispositivos. Los invitados seguirán usando localStorage; al
//  iniciar sesión, fusionaremos su carrito local con este (lógica de Etapa 3).
//
//  Por ahora asumimos un renglón por producto (@@unique por profile+slug) y
//  una cantidad. Si más adelante los productos tienen variantes reales
//  (color/material seleccionable), añadiremos ese campo a la clave única.
// ============================================================================
model CartItem {
  id        String  @id @default(uuid())
  profileId String  @db.Uuid
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  productSlug String
  quantity    Int    @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, productSlug])
  @@index([profileId])
  @@map("cart_items")
}

// ============================================================================
//  MODELO: Product  (Producto del catálogo)
// ----------------------------------------------------------------------------
//  Un producto en venta. Reemplaza a los objetos de src/data/products.ts y
//  product-details.ts: aquí vive TODO lo que antes estaba repartido entre el
//  tipo Product (listados) y ProductDetail (página de detalle).
//
//  BILINGÜE: nombre y descripción se guardan en dos columnas (…Es / …En). El
//  código las junta de nuevo en un LocalizedString { es, en } para no tener
//  que cambiar los componentes que ya usan getLocalized().
//
//  STOCK: `stock` es la cantidad disponible. "inStock" ya NO se guarda: se
//  calcula como stock > 0, para que nunca se contradigan. Lo mismo con el
//  badge "agotado": se muestra solo cuando stock = 0.
// ============================================================================
model Product {
  // Se conserva el id que ya tenía cada producto en código (el seed lo copia);
  // los productos nuevos reciben un UUID automático.
  id   String @id @default(uuid())
  slug String @unique // identificador en la URL y en pedidos/carrito (ej. "aretes-camelia")

  // Textos bilingües. "Es" y "En" en lugar de un campo JSON: son más fáciles
  // de consultar, validar y mostrar en el formulario del admin.
  nameEs        String
  nameEn        String
  descriptionEs String @db.Text // puede traer \n para separar párrafos
  descriptionEn String @db.Text

  // Claves tipadas en el código (ProductCategory / ProductMaterial /
  // ProductColor). Se guardan como texto y se validan contra esas listas al
  // crear o editar, así agregar una categoría nueva NO exige migrar la BD.
  category String // "Aretes" | "Collares" | "Pulseras" | "Gargantillas"
  material String // "plata-925" | "oro-rosa" | ...
  color    String // "dorado" | "plateado" | ...

  // Precios en pesos enteros (igual que en Order y Reservation).
  price         Int
  originalPrice Int? // precio antes de la oferta; null = sin oferta

  // Etiqueta editorial opcional: "nuevo" | "oferta" | "limitado".
  // ("agotado" no se guarda: se deduce de stock = 0.)
  badge String?

  // Inventario. Se descuenta al pagar un pedido y al apartar (Etapa 3).
  stock Int @default(0)

  // false = oculto en la tienda (borrador o retirado) pero conservado para el
  // historial. Se usa en lugar de borrar productos que ya tuvieron ventas.
  isActive Boolean @default(true)

  // Dimensiones físicas, todas opcionales. Los números son universales; solo
  // las notas se traducen.
  lengthCm        Float?
  widthCm         Float?
  heightCm        Float?
  weightG         Float?
  dimensionNotesEs String?
  dimensionNotesEn String?

  // Instrucciones de cuidado: una lista por idioma (arreglos nativos de Postgres).
  careInstructionsEs String[]
  careInstructionsEn String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images ProductImage[]

  // Índices para las consultas más comunes: listar por categoría solo lo
  // visible, y mostrar lo más nuevo primero.
  @@index([category, isActive])
  @@index([createdAt])
  @@map("products")
}

// ============================================================================
//  MODELO: ProductImage  (Imagen de un producto)
// ----------------------------------------------------------------------------
//  Un producto tiene varias imágenes ordenadas; la de `position` 0 es la
//  principal (la que sale en tarjetas y listados).
//
//  `url` es lo que usa la tienda para mostrarla: puede ser una ruta local
//  ("/placeholder-…", como las actuales) o la URL pública de Supabase Storage
//  cuando el admin sube una foto real.
//  `storagePath` guarda la ruta dentro del bucket de Storage (null en los
//  placeholders) para poder BORRAR el archivo cuando se elimine la imagen y no
//  dejar archivos huérfanos ocupando espacio.
// ============================================================================
model ProductImage {
  id        String  @id @default(uuid())
  productId String
  // onDelete: Cascade → si se borra el producto, se borran sus filas de imagen.
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  url         String
  alt         String   @default("") // texto alternativo (accesibilidad y SEO)
  position    Int      @default(0) // orden de aparición; 0 = principal
  storagePath String? // ruta en el bucket de Supabase Storage (null = no está en Storage)

  createdAt DateTime @default(now())

  @@index([productId, position]) // traer las imágenes de un producto ya ordenadas
  @@map("product_images")
}
